              <property>http://www.w3.org/2000/01/rdf-schema#label</property>
              <object>
                <lexicalForm>Legally-Specific Education and Training Programme</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/stat/onto/EducationTraining/EstabilishedEducationTrainingProgramme</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>Percorso di  istruzione e formazione,  disciplinato nell'ambito di uno specifico quadro legislativo. Ciascun percorso è definito dalla combinazione tra un Programma generale di istruzione e formazione e uno specifico Ordinamento.</lexicalForm>
                <datatype/>
                <language>it</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/stat/onto/EducationTraining/EstabilishedEducationTrainingProgramme</subject>
              <property>http://www.w3.org/2003/06/sw-vocab-status/ns#term_status</property>
              <object>
                <lexicalForm>unstable</lexicalForm>
                <datatype/>
                <language/>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/stat/onto/EducationTraining/EstabilishedEducationTrainingProgramme</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>An education and training programme regulated within a specific legislative framework. Each programme is defined by the combination of a general education and training programme and a specific set of regulations.</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
          </annotations>
