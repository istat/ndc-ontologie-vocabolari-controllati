                <lexicalForm>Educational Position</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus</subject>
              <property>http://www.w3.org/2000/01/rdf-schema#comment</property>
              <object>
                <lexicalForm>A relationship between an individual, an education and training institution, and an education and training programme over a given period of time.</lexicalForm>
                <datatype/>
                <language>en</language>
              </object>
            </annotation>
            <annotation>
              <subject>https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus</subject>
