    <owl:Ontology rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining">
        <owl:versionIRI rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/1.0"/>
        <dc:description rdf:resource="https://raw.githubusercontent.com/istat/ndc-ontologie-vocabolari-controllati/tree/main/assets/ontologies/education-and-labour/education-and-training/FormalEducationTraining/latest/FormalEducationTraining.png"/>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
        <dct:creator rdf:resource="https://w3id.org/italia/data/public-organization/ISTAT"/>
        <dct:description xml:lang="en">Formal Education and Training Ontology</dct:description>
        <dct:description xml:lang="it">Ontologia dell&apos;Istruzione e Formazione Formale</dct:description>
        <dct:identifier>https://w3id.org/italia/stat/onto/FormalEducationTraining</dct:identifier>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-24</dct:issued>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ENG"/>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/ITA"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-24</dct:modified>
        <dct:publisher rdf:resource="https://w3id.org/italia/data/public-organization/ISTAT"/>
        <dct:rightsHolder rdf:resource="https://w3id.org/italia/data/public-organization/ISTAT"/>
        <dct:subject rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/>
        <dct:temporal>Dal 2026</dct:temporal>
        <dct:title xml:lang="en">Formal Education and Training Ontology</dct:title>
        <dct:title xml:lang="it">Ontologia dell&apos;Istruzione e Formazione Formale</dct:title>
        <rdfs:comment xml:lang="it">Modello concettuale standardizzato per la rappresentazione semantica e l&apos;interoperabilità dei dati relativi alle carriere educative e formative in Italia. Il modello mappa l&apos;esperienza dell&apos;individuo descrivendo, tra le altre cose, il percorso di istruzione intrapreso, i titoli di studio conseguiti e il livello educativo raggiunto.</rdfs:comment>
        <rdfs:comment xml:lang="en">Standardized conceptual model for the semantic representation and data interoperability of educational and training careers in Italy. The model maps the individuals&apos;s experience by describing, among other things, the education programmes pursued, the educational attainment and the education level achieved.</rdfs:comment>
        <rdfs:label xml:lang="en">Formal Education and Training Ontology</rdfs:label>
        <rdfs:label xml:lang="it">Ontologia dell&apos;Istruzione e Formazione Formale</rdfs:label>
        <owl:versionInfo xml:lang="en">Version 1.0</owl:versionInfo>
        <owl:versionInfo xml:lang="it">Versione 1.0</owl:versionInfo>
        <dcat:contactPoint rdf:resource="https://w3id.org/italia/data/contact-point/ISTAT-NDC"/>
        <dcat:keyword xml:lang="en">Education</dcat:keyword>
        <dcat:keyword xml:lang="it">Educazione</dcat:keyword>
        <dcat:keyword xml:lang="it">Formazione</dcat:keyword>
        <dcat:keyword xml:lang="en">Training</dcat:keyword>
        <dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/EDUC"/>
        <admsapit:acronym>EAT</admsapit:acronym>
        <admsapit:hasKeyClass rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus"/>
        <admsapit:hasOntologyLanguage rdf:resource="https://w3id.org/italia/onto/ADMS/OWL"/>
        <admsapit:hasSemanticAssetDistribution rdf:resource="https://w3id.org/italia/data/distribution/EAT-JSON-LD"/>
        <admsapit:hasSemanticAssetDistribution rdf:resource="https://w3id.org/italia/data/distribution/EAT-RDF-TURTLE"/>
        <admsapit:hasSemanticAssetDistribution rdf:resource="https://w3id.org/italia/data/distribution/EAT-RDF-XML"/>
        <admsapit:hasTask rdf:resource="https://w3id.org/italia/onto/ADMS/AnnotationTask"/>
        <admsapit:hasTask rdf:resource="https://w3id.org/italia/onto/ADMS/QueryFormulationTask"/>
        <admsapit:hasTask rdf:resource="https://w3id.org/italia/onto/ADMS/SearchTask"/>
        <admsapit:last rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/1.0"/>
        <admsapit:officialURI rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://w3id.org/italia/stat/onto/FormalEducationTraining</admsapit:officialURI>
        <admsapit:prefix>eat</admsapit:prefix>
        <admsapit:semanticAssetInUse rdf:resource="https://w3id.org/italia/data/project/NDC"/>
        <admsapit:status>draft</admsapit:status>
        <admsapit:target>Pubbliche Amministrazioni</admsapit:target>
        <admsapit:type rdf:resource="https://w3id.org/italia/onto/ADMS/DomainOntology"/>
    </owl:Ontology>
    


