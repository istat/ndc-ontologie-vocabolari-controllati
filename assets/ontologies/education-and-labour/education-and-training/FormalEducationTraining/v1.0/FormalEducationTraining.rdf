    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationProgramme -->

    <owl:Class rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationProgramme">
        <rdfs:comment xml:lang="en">General Education and training programmes, regulated by legislation, structured into sequential cycles, and designed to achieve specific and clearly identifiable learning outcomes.</rdfs:comment>
        <rdfs:comment xml:lang="it">Programmi generali di istruzione e formazione, disciplinati dal legislatore, strutturati in cicli sequenziali e finalizzati al conseguimento di specifici e riconoscibili obiettivi di apprendimento.</rdfs:comment>
        <rdfs:label xml:lang="en">General Education and Training Programme</rdfs:label>
        <rdfs:label xml:lang="it">Programma generale di istruzione e formazione</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus -->

    <owl:Class rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/studentInEducationStatus"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:comment xml:lang="en">A relationship between an individual, an education and training institution, and an education and training programme over a given period of time.</rdfs:comment>
        <rdfs:comment xml:lang="it">Relazione che si instaura tra una persona, un’istituzione che eroga istruzione e formazione e un programma di istruzione e formazione in un periodo di tempo.</rdfs:comment>
        <rdfs:label xml:lang="en">Educational Position</rdfs:label>
        <rdfs:label xml:lang="it">Posizione Formativa</rdfs:label>
        <vs:term_status>unstable</vs:term_status>
    </owl:Class>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainment -->

    <owl:Class rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainment">
        <rdfs:comment xml:lang="en">An official document with legal and functional validity, issued upon the successful completion of a legally regulated education or training programme. This document formally certifies the completion of a specific cycle of education and attests to the knowledge, skills, and competences acquired, typically following the successful completion of a State examination or a final assessment. Its primary purpose is to qualify the holder for access to higher levels of education or entry into the labour market, based on legal provisions governing its equivalence and recognition for administrative and competitive recruitment purposes.</rdfs:comment>
        <rdfs:comment xml:lang="it">Documento ufficiale dotato di valore legale e funzionale che viene rilasciato al completamento di un percorso d’istruzione o formazione regolamentato dalla legge. Tale atto attesta formalmente la conclusione di un determinato ciclo di studi e certifica le conoscenze e le competenze acquisite, solitamente in seguito al superamento di un esame di Stato o di una prova di verifica finale. La sua funzione principale consiste nel qualificare il possessore per l&apos;accesso ai livelli di istruzione superiori o per l&apos;inserimento nel mercato del lavoro, sulla base di fonti normative che ne disciplinano l’equipollenza e l’equiparazione ai fini amministrativi e concorsuali.</rdfs:comment>
        <rdfs:label xml:lang="en">Educational Attainment</rdfs:label>
        <rdfs:label xml:lang="it">Titolo di Studio</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainmentObtained -->

    <owl:Class rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainmentObtained">
        <rdfs:label xml:lang="it">Denominazione titolo di studio ottenuto</rdfs:label>
        <rdfs:label xml:lang="en">Educational Attainment Obtained</rdfs:label>
        <vs:term_status>unstable</vs:term_status>
    </owl:Class>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/EstabilishedEducationTrainingProgramme -->

    <owl:Class rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/EstabilishedEducationTrainingProgramme">
        <rdfs:subClassOf rdf:resource="https://w3id.org/italia/onto/TI/TimeIndexedEvent"/>
        <rdfs:comment xml:lang="en">An education and training programme regulated within a specific legislative framework. Each programme is defined by the combination of a general education and training programme and a specific set of regulations.</rdfs:comment>
        <rdfs:comment xml:lang="it">Percorso di  istruzione e formazione,  disciplinato nell&apos;ambito di uno specifico quadro legislativo. Ciascun percorso è definito dalla combinazione tra un Programma generale di istruzione e formazione e uno specifico Ordinamento.</rdfs:comment>
        <rdfs:label xml:lang="en">Legally-Specific Education and Training Programme</rdfs:label>
        <rdfs:label xml:lang="it">Percorso di istruzione</rdfs:label>
        <vs:term_status>unstable</vs:term_status>
    </owl:Class>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/Ordinamento -->

    <owl:Class rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/Ordinamento">
        <rdfs:comment xml:lang="it">Insieme delle disposizioni normative, organizzative e didattiche che disciplinano la struttura del sistema educativo, definendone i percorsi, i livelli, i titoli rilasciati, le modalità di accesso, i requisiti di frequenza e di valutazione, nonché i criteri per il conseguimento delle qualificazioni in un quadro di  coerenza,  validità giuridica e riconoscimento istituzionale.</rdfs:comment>
        <rdfs:comment xml:lang="en">The set of legal, organisational, and educational provisions governing the structure of the education system, defining its programmes, levels, qualifications awarded, admission requirements, attendance and assessment requirements, as well as the criteria for the award of qualifications, within a framework that ensures coherence, legal validity, and institutional recognition.</rdfs:comment>
        <rdfs:label xml:lang="it">Ordinamento</rdfs:label>
        <rdfs:label xml:lang="en">Regulatory Framework</rdfs:label>
        <vs:term_status>unstable</vs:term_status>
    </owl:Class>
    


