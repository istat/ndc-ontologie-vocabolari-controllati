    <!-- https://w3id.org/italia/onto/CPV/hasLevelOfEducation -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/onto/CPV/hasLevelOfEducation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CPV/EducationLevel"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/assignedToEducationStatus -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/assignedToEducationStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EstabilishedEducationTrainingProgramme"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus"/>
        <rdfs:label xml:lang="it">assegnato a Posizione Formativa</rdfs:label>
        <rdfs:label xml:lang="en">assigned to Educational Status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/enableAchievement -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/enableAchievement">
        <rdfs:domain rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EstabilishedEducationTrainingProgramme"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainment"/>
        <rdfs:label xml:lang="it">ablita conseguimento</rdfs:label>
        <rdfs:label xml:lang="en">enables achievement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/enableTrainingProgram -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/enableTrainingProgram">
        <rdfs:domain rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EstabilishedEducationTrainingProgramme"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationProgramme"/>
        <rdfs:label xml:lang="en">Referred to Training Program</rdfs:label>
        <rdfs:label xml:lang="it">si riferisce a programma di istruzione</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/establishes -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/establishes">
        <rdfs:domain rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EstabilishedEducationTrainingProgramme"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/Ordinamento"/>
        <rdfs:label xml:lang="en">establish</rdfs:label>
        <rdfs:label xml:lang="it">è regolamentato</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/hasObtainedEducationalAttainment -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/hasObtainedEducationalAttainment">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainmentObtained"/>
        <rdfs:label xml:lang="it">haConseguitoTitoloDiStudio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/isHighest -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/isHighest">
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/EducationLevel"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainment"/>
        <rdfs:label xml:lang="en">Highest educational attainment</rdfs:label>
        <rdfs:label xml:lang="it">è massimo titolo di studio conseguito</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/relatedTo -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/relatedTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/Learning/Institute"/>
        <rdfs:label xml:lang="en">relatedTo</rdfs:label>
        <rdfs:label xml:lang="it">relativo a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/stat/onto/FormalEducationTraining/studentInEducationStatus -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/stat/onto/FormalEducationTraining/studentInEducationStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/onto/CPV/Person"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus"/>
        <rdfs:label xml:lang="it">ha Posizione Formativa</rdfs:label>
        <rdfs:label xml:lang="en">has Educational Status</rdfs:label>
    </owl:ObjectProperty>
    


