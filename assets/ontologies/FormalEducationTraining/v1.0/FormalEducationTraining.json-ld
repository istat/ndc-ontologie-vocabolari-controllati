  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Formal Education and Training Ontology"
  }, {
    "@language" : "it",
    "@value" : "Ontologia dell'Istruzione e Formazione Formale"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "it",
    "@value" : "Modello concettuale standardizzato per la rappresentazione semantica e l'interoperabilità dei dati relativi alle carriere educative e formative in Italia. Il modello mappa l'esperienza dell'individuo descrivendo, tra le altre cose, il percorso di istruzione intrapreso, i titoli di studio conseguiti e il livello educativo raggiunto."
  }, {
    "@language" : "en",
    "@value" : "Standardized conceptual model for the semantic representation and data interoperability of educational and training careers in Italy. The model maps the individuals's experience by describing, among other things, the education programmes pursued, the educational attainment and the education level achieved."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Formal Education and Training Ontology"
  }, {
    "@language" : "it",
    "@value" : "Ontologia dell'Istruzione e Formazione Formale"
  } ],
