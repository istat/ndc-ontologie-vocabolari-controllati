}, {
  "@id" : "https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationProgramme",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "General Education and training programmes, regulated by legislation, structured into sequential cycles, and designed to achieve specific and clearly identifiable learning outcomes."
  }, {
    "@language" : "it",
    "@value" : "Programmi generali di istruzione e formazione, disciplinati dal legislatore, strutturati in cicli sequenziali e finalizzati al conseguimento di specifici e riconoscibili obiettivi di apprendimento."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "General Education and Training Programme"
  }, {
    "@language" : "it",
    "@value" : "Programma generale di istruzione e formazione"
  } ]
}, {
  "@id" : "https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A relationship between an individual, an education and training institution, and an education and training programme over a given period of time."
  }, {
    "@language" : "it",
    "@value" : "Relazione che si instaura tra una persona, un’istituzione che eroga istruzione e formazione e un programma di istruzione e formazione in un periodo di tempo."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Educational Position"
  }, {
    "@language" : "it",
    "@value" : "Posizione Formativa"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/italia/onto/TI/TimeIndexedEvent"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid1"
  } ],
  "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status" : [ {
    "@value" : "unstable"
  } ]
}, {
  "@id" : "https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainment",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An official document with legal and functional validity, issued upon the successful completion of a legally regulated education or training programme. This document formally certifies the completion of a specific cycle of education and attests to the knowledge, skills, and competences acquired, typically following the successful completion of a State examination or a final assessment. Its primary purpose is to qualify the holder for access to higher levels of education or entry into the labour market, based on legal provisions governing its equivalence and recognition for administrative and competitive recruitment purposes."
  }, {
    "@language" : "it",
    "@value" : "Documento ufficiale dotato di valore legale e funzionale che viene rilasciato al completamento di un percorso d’istruzione o formazione regolamentato dalla legge. Tale atto attesta formalmente la conclusione di un determinato ciclo di studi e certifica le conoscenze e le competenze acquisite, solitamente in seguito al superamento di un esame di Stato o di una prova di verifica finale. La sua funzione principale consiste nel qualificare il possessore per l'accesso ai livelli di istruzione superiori o per l'inserimento nel mercato del lavoro, sulla base di fonti normative che ne disciplinano l’equipollenza e l’equiparazione ai fini amministrativi e concorsuali."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Educational Attainment"
  }, {
    "@language" : "it",
    "@value" : "Titolo di Studio"
  } ]
}, {
  "@id" : "https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainmentObtained",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "it",
    "@value" : "Denominazione titolo di studio ottenuto"
  }, {
    "@language" : "en",
    "@value" : "Educational Attainment Obtained"
  } ],
  "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status" : [ {
    "@value" : "unstable"
  } ]
}, {
  "@id" : "https://w3id.org/italia/stat/onto/FormalEducationTraining/EstabilishedEducationTrainingProgramme",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An education and training programme regulated within a specific legislative framework. Each programme is defined by the combination of a general education and training programme and a specific set of regulations."
  }, {
    "@language" : "it",
    "@value" : "Percorso di  istruzione e formazione,  disciplinato nell'ambito di uno specifico quadro legislativo. Ciascun percorso è definito dalla combinazione tra un Percorso generale di istruzione e formazione e uno specifico Ordinamento."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Legally-Specific Education and Training Programme"
  }, {
    "@language" : "it",
    "@value" : "Percorso di istruzione"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/italia/onto/TI/TimeIndexedEvent"
  } ],
  "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status" : [ {
    "@value" : "unstable"
  } ]
}, {
  "@id" : "https://w3id.org/italia/stat/onto/FormalEducationTraining/Ordinamento",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "it",
    "@value" : "Insieme delle disposizioni normative, organizzative e didattiche che disciplinano la struttura del sistema educativo, definendone i percorsi, i livelli, i titoli rilasciati, le modalità di accesso, i requisiti di frequenza e di valutazione, nonché i criteri per il conseguimento delle qualificazioni in un quadro di  coerenza,  validità giuridica e riconoscimento istituzionale."
  }, {
    "@language" : "en",
    "@value" : "The set of legal, organisational, and educational provisions governing the structure of the education system, defining its programmes, levels, qualifications awarded, admission requirements, attendance and assessment requirements, as well as the criteria for the award of qualifications, within a framework that ensures coherence, legal validity, and institutional recognition."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "it",
    "@value" : "Ordinamento"
  }, {
    "@language" : "en",
    "@value" : "Regulatory Framework"
  } ],
  "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status" : [ {
    "@value" : "unstable"
  } ]
}, {
  "@id" : "https://w3id.org/italia/stat/onto/FormalEducationTraining/assignedToEducationStatus",
