xsd:string rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/italia/onto/CPV/hasLevelOfEducation
CPV:hasLevelOfEducation rdf:type owl:ObjectProperty ,
                                 owl:FunctionalProperty ;
                        rdfs:domain CPV:Person ;
                        rdfs:range CPV:EducationLevel .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/assignedToEducationStatus
eat:assignedToEducationStatus rdf:type owl:ObjectProperty ,
                                       owl:InverseFunctionalProperty ;
                              rdfs:domain eat:EstabilishedEducationTrainingProgramme ;
                              rdfs:range eat:EducationStatus ;
                              rdfs:label "assegnato a Posizione Formativa"@it ,
                                         "assigned to Educational Status"@en .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/enableAchievement
eat:enableAchievement rdf:type owl:ObjectProperty ;
                      rdfs:domain eat:EstabilishedEducationTrainingProgramme ;
                      rdfs:range eat:EducationalAttainment ;
                      rdfs:label "ablita conseguimento"@it ,
                                 "enables achievement"@en .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/enableTrainingProgram
eat:enableTrainingProgram rdf:type owl:ObjectProperty ;
                          rdfs:domain eat:EstabilishedEducationTrainingProgramme ;
                          rdfs:range eat:EducationProgramme ;
                          rdfs:label "Referred to Training Program"@en ,
                                     "si riferisce a programma di istruzione"@it .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/establishes
eat:establishes rdf:type owl:ObjectProperty ;
                rdfs:domain eat:EstabilishedEducationTrainingProgramme ;
                rdfs:range eat:Ordinamento ;
                rdfs:label "establish"@en ,
                           "è regolamentato"@it .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/hasObtainedEducationalAttainment
eat:hasObtainedEducationalAttainment rdf:type owl:ObjectProperty ;
                                     rdfs:domain CPV:Person ;
                                     rdfs:range eat:EducationalAttainmentObtained ;
                                     rdfs:label "haConseguitoTitoloDiStudio"@it .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/isHighest
eat:isHighest rdf:type owl:ObjectProperty ;
              rdfs:domain CPV:EducationLevel ;
              rdfs:range eat:EducationalAttainment ;
              rdfs:label "Highest educational attainment"@en ,
                         "è massimo titolo di studio conseguito"@it .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/relatedTo
eat:relatedTo rdf:type owl:ObjectProperty ,
                       owl:InverseFunctionalProperty ;
              rdfs:domain eat:EducationStatus ;
              rdfs:range learning:Institute ;
              rdfs:label "relatedTo"@en ,
                         "relativo a"@it .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/studentInEducationStatus
eat:studentInEducationStatus rdf:type owl:ObjectProperty ,
                                      owl:InverseFunctionalProperty ;
                             rdfs:domain CPV:Person ;
                             rdfs:range eat:EducationStatus ;
                             rdfs:label "ha Posizione Formativa"@it ,
                                        "has Educational Status"@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/italia/stat/onto/FormalEducationTraining/attainmentDate
eat:attainmentDate rdf:type owl:DatatypeProperty ,
                            owl:FunctionalProperty ;
                   rdfs:domain eat:EducationalAttainmentObtained ;
                   rdfs:range xsd:string ;
                   rdfs:label "data conseguimento titolo"@it .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/gradeAchieved
eat:gradeAchieved rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain eat:EducationalAttainmentObtained ;
                  rdfs:range xsd:string ;
                  rdfs:label "grade"@en ,
                             "voto conseguimento titolo"@it .


#################################################################
#    Classes
#################################################################

###  https://w3id.org/italia/onto/CPV/EducationLevel
CPV:EducationLevel rdf:type owl:Class .


###  https://w3id.org/italia/onto/CPV/Person
CPV:Person rdf:type owl:Class .


###  https://w3id.org/italia/onto/Learning/Institute
learning:Institute rdf:type owl:Class .


###  https://w3id.org/italia/onto/TI/TimeIndexedEvent
TI:TimeIndexedEvent rdf:type owl:Class .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationProgramme
eat:EducationProgramme rdf:type owl:Class ;
                       rdfs:comment "General Education and training programmes, regulated by legislation, structured into sequential cycles, and designed to achieve specific and clearly identifiable learning outcomes."@en ,
                                    "Programmi generali di istruzione e formazione, disciplinati dal legislatore, strutturati in cicli sequenziali e finalizzati al conseguimento di specifici e riconoscibili obiettivi di apprendimento."@it ;
                       rdfs:label "General Education and Training Programme"@en ,
                                  "Programma generale di istruzione e formazione"@it .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationStatus
eat:EducationStatus rdf:type owl:Class ;
                    owl:equivalentClass [ rdf:type owl:Restriction ;
                                          owl:onProperty [ owl:inverseOf eat:studentInEducationStatus
                                                         ] ;
                                          owl:someValuesFrom owl:Thing
                                        ] ;
                    rdfs:subClassOf TI:TimeIndexedEvent ;
                    rdfs:comment "A relationship between an individual, an education and training institution, and an education and training programme over a given period of time."@en ,
                                 "Relazione che si instaura tra una persona, un’istituzione che eroga istruzione e formazione e un programma di istruzione e formazione in un periodo di tempo."@it ;
                    rdfs:label "Educational Position"@en ,
                               "Posizione Formativa"@it ;
                    vs:term_status "unstable" .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainment
eat:EducationalAttainment rdf:type owl:Class ;
                          rdfs:comment "An official document with legal and functional validity, issued upon the successful completion of a legally regulated education or training programme. This document formally certifies the completion of a specific cycle of education and attests to the knowledge, skills, and competences acquired, typically following the successful completion of a State examination or a final assessment. Its primary purpose is to qualify the holder for access to higher levels of education or entry into the labour market, based on legal provisions governing its equivalence and recognition for administrative and competitive recruitment purposes."@en ,
                                       "Documento ufficiale dotato di valore legale e funzionale che viene rilasciato al completamento di un percorso d’istruzione o formazione regolamentato dalla legge. Tale atto attesta formalmente la conclusione di un determinato ciclo di studi e certifica le conoscenze e le competenze acquisite, solitamente in seguito al superamento di un esame di Stato o di una prova di verifica finale. La sua funzione principale consiste nel qualificare il possessore per l'accesso ai livelli di istruzione superiori o per l'inserimento nel mercato del lavoro, sulla base di fonti normative che ne disciplinano l’equipollenza e l’equiparazione ai fini amministrativi e concorsuali."@it ;
                          rdfs:label "Educational Attainment"@en ,
                                     "Titolo di Studio"@it .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/EducationalAttainmentObtained
eat:EducationalAttainmentObtained rdf:type owl:Class ;
                                  rdfs:label "Denominazione titolo di studio ottenuto"@it ,
                                             "Educational Attainment Obtained"@en ;
                                  vs:term_status "unstable" .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/EstabilishedEducationTrainingProgramme
eat:EstabilishedEducationTrainingProgramme rdf:type owl:Class ;
                                           rdfs:subClassOf TI:TimeIndexedEvent ;
                                           rdfs:comment "An education and training programme regulated within a specific legislative framework. Each programme is defined by the combination of a general education and training programme and a specific set of regulations."@en ,
                                                        "Percorso di  istruzione e formazione,  disciplinato nell'ambito di uno specifico quadro legislativo. Ciascun percorso è definito dalla combinazione tra un Percorso generale di istruzione e formazione e uno specifico Ordinamento."@it ;
                                           rdfs:label "Legally-Specific Education and Training Programme"@en ,
                                                      "Percorso di istruzione"@it ;
                                           vs:term_status "unstable" .


###  https://w3id.org/italia/stat/onto/FormalEducationTraining/Ordinamento
eat:Ordinamento rdf:type owl:Class ;
                rdfs:comment "Insieme delle disposizioni normative, organizzative e didattiche che disciplinano la struttura del sistema educativo, definendone i percorsi, i livelli, i titoli rilasciati, le modalità di accesso, i requisiti di frequenza e di valutazione, nonché i criteri per il conseguimento delle qualificazioni in un quadro di  coerenza,  validità giuridica e riconoscimento istituzionale."@it ,
                             "The set of legal, organisational, and educational provisions governing the structure of the education system, defining its programmes, levels, qualifications awarded, admission requirements, attendance and assessment requirements, as well as the criteria for the award of qualifications, within a framework that ensures coherence, legal validity, and institutional recognition."@en ;
                rdfs:label "Ordinamento"@it ,
                           "Regulatory Framework"@en ;
                vs:term_status "unstable" .


